FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

# Copy the entire project
COPY . /app

# Install dependencies and the local package in editable mode
# This ensures we use the local code with header support, not PyPI version
RUN uv sync --locked --no-dev

# Set PATH to include venv bin directory
ENV PATH="/app/.venv/bin:${PATH}"

# Run the server directly using the installed command (uses local editable install)
# This is equivalent to uvx but ensures we use the local code
CMD ["sh", "-c", "mcp-server-snowflake --service-config-file /app/services/tools_config.yaml --transport streamable-http --port ${PORT:-9000}"]
